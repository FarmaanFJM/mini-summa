{
  "name": "@minisumma/android",
  "version": "0.1.0",
  "private": true,
  "description": "Mini-Summa Android companion: status, reports, activity, notifications and guarded intervention for the Mini-Summa core on your PC.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.config.json",
    "test": "jest",
    "doctor": "npx --yes expo-doctor",
    "export": "expo export --platform android",
    "prebuild": "expo prebuild --platform android",
    "build:apk": "node scripts/build-apk.mjs",
    "check:core": "../../node_modules/.bin/tsx --tsconfig tsconfig.json scripts/core-check.ts"
  },
  "dependencies": {
    "expo": "~58.0.21",
    "expo-build-properties": "~58.0.11",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-linking": "~58.0.15",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.28",
    "expo-secure-store": "~58.0.2",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.13",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  }
}
