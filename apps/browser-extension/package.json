{
  "name": "@minisumma/browser-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Optional MV3 extension: focuses the mapped ChatGPT conversation tab using documented tabs/windows APIs only.",
  "scripts": {
    "build": "node build.mjs",
    "build:test": "node build.mjs --test-hosts",
    "test": "vitest run",
    "test:real": "node build.mjs --test-hosts && xvfb-run -a node test/real-browser.mjs",
    "test:core": "node build.mjs --test-hosts && xvfb-run -a node test/with-real-core.mjs",
    "test:keepalive": "node build.mjs --test-hosts && xvfb-run -a node test/keepalive.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": { "@minisumma/shared": "*" },
  "devDependencies": { "@types/chrome": "^0.1.40" }
}
