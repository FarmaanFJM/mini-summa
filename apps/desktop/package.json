{
  "name": "@minisumma/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mini-Summa desktop application (Electron + React).",
  "author": "Mini-Summa",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "npm run build:hook -w @minisumma/claude-integration && electron-vite build && electron-vite preview",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run test",
    "typecheck": "tsc -p tsconfig.json",
    "e2e": "node e2e/run.mjs",
    "e2e:report": "node e2e/report.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:core": "node scripts/smoke-real-core.mjs",
    "icons": "node scripts/make-icons.mjs",
    "dist:win": "npm run build:hook -w @minisumma/claude-integration && electron-vite build && electron-builder --win nsis --x64 --config electron-builder.yml",
    "dist:win:zip": "npm run build:hook -w @minisumma/claude-integration && electron-vite build && electron-builder --win zip --x64 --config electron-builder.yml",
    "dist:dir": "npm run build:hook -w @minisumma/claude-integration && electron-vite build && electron-builder --linux dir --config electron-builder.yml"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@lydell/node-pty": "1.2.0-beta.18",
    "@minisumma/claude-integration": "*",
    "@minisumma/core": "*",
    "@minisumma/shared": "*",
    "@minisumma/storage": "*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "hono": "^4.13.14",
    "lucide-react": "^1.65.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "jsdom": "^30.1.3",
    "playwright": "^1.63.0",
    "vite": "^8.3.5"
  }
}
